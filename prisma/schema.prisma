generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String              @id @default(uuid())
  email                     String              @unique
  password                  String
  name                      String
  avatar                    String?
  role                      Role                @default(INDIVIDUAL)
  classCode                 String?             @unique
  whatsappGroupId           String?             @unique
  joinedClassId             String?
  joinedClass               User?               @relation("ClassStudents", fields: [joinedClassId], references: [id], onDelete: SetNull)
  students                  User[]              @relation("ClassStudents")
  emailVerified             Boolean             @default(true)
  verificationCode          String?
  remindersEnabled          Boolean             @default(false)
  semesterTransitionEnabled Boolean             @default(true)
  scheduleReminderOffsets   Int[]               @default([360, 180, 60])
  taskReminderOffsets       Int[]               @default([1440, 720])
  notificationChannel       NotificationChannel @default(EMAIL)
  whatsappNumber            String?
  whatsappJid               String?             // Full JID/LID e.g. 628xxx@s.whatsapp.net or xxx@lid (for WA Desktop/Web)
  quietHoursStart           String?             // HH:mm
  quietHoursEnd             String?             // HH:mm
  dailySummaryTime          String              @default("07:00") // HH:mm
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  semesters                 Semester[]
  tasks                     Task[]
  sentReminders             SentReminder[]
  customHolidays            CustomHoliday[]
  conversationTurns         ConversationTurn[]
  submissions               TaskSubmission[]
}

enum Role {
  INDIVIDUAL
  CLASS
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  NONE
}

model Semester {
  id                String    @id @default(uuid())
  userId            String
  name              String
  startDate         DateTime
  endDate           DateTime
  academicStartDate DateTime?
  holidayStartDate  DateTime?
  isActive          Boolean   @default(false)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses           Course[]

  @@index([userId, isActive])
}

model Course {
  id         String     @id @default(uuid())
  semesterId String
  code       String
  name       String
  credits    Int
  lecturer   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now()) @updatedAt
  semester   Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  schedules  Schedule[]
  tasks      Task[]
  resources  CourseResource[]

  @@unique([semesterId, code])
}

model Schedule {
  id         String              @id @default(uuid())
  courseId   String
  dayOfWeek  Int
  startTime  String
  endTime    String
  room       String?
  link       String?             // URL kelas online (Zoom/Meet/Teams)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @default(now()) @updatedAt
  course     Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  exceptions ScheduleException[]

  @@index([courseId, dayOfWeek])
}

model ScheduleException {
  id           String        @id @default(uuid())
  scheduleId   String
  date         String        // YYYY-MM-DD (date string, timezone-safe)
  type         ExceptionType @default(CANCELLED)
  newStartTime String?       // jika MOVED
  newEndTime   String?
  newRoom      String?
  newLink      String?       // link override untuk hari itu
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  schedule     Schedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, date])  // satu exception per jadwal per hari
}

model Task {
  id               String               @id @default(uuid())
  userId           String
  courseId         String?
  title            String
  description      String?
  deadline         DateTime
  status           TaskStatus           @default(PENDING)
  priority         Priority             @default(MEDIUM)
  completedAt      DateTime?
  isGroupTask      Boolean              @default(false)
  myPart           String?
  weightPercentage Int?
  submissionMethod SubmissionMethod     @default(OFFLINE)
  submissionLink   String?
  snoozedUntil     DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @default(now()) @updatedAt
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  checklist        TaskChecklistItem[]
  attachments      TaskAttachment[]
  resources        CourseResource[]
  submissions      TaskSubmission[]

  @@index([userId, status, deadline])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum SubmissionMethod {
  GFORM
  EMAIL
  LMS
  UPLOAD
  OFFLINE
}

model TaskChecklistItem {
  id          String   @id @default(uuid())
  taskId      String
  title       String
  isCompleted Boolean  @default(false)
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

enum ExceptionType {
  CANCELLED  // kelas dibatalkan
  MOVED      // waktu/ruang berubah
  NOTE       // hanya catatan informasi
}

model SentReminder {
  id        String   @id @default(uuid())
  userId    String
  targetId  String   // scheduleId or taskId
  offset    Int      // the offset that triggered it (e.g. 6)
  sentAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId, offset])
}

model WhatsappQueue {
  id        String   @id @default(uuid())
  groupId   String
  message   String
  isHidetag Boolean  @default(false)
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([sent, createdAt])
}

model CustomHoliday {
  id        String   @id @default(uuid())
  userId    String
  name      String
  startDate String   // YYYY-MM-DD
  endDate   String   // YYYY-MM-DD
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConversationTurn {
  id        String   @id @default(uuid())
  userId    String
  role      String   // "user", "model", "function"
  name      String?  // for function name
  content   String   // text or JSON string for function results/parameters
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model TaskAttachment {
  id        String   @id @default(uuid())
  taskId    String
  name      String   // Nama file asli
  filePath  String   // Unpredictable random string/filename on server
  fileType  String   // MIME type
  fileSize  Int      // Size in bytes
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model CourseResource {
  id           String       @id @default(uuid())
  courseId     String
  taskId       String?      // opsional — link ke task tertentu
  title        String
  type         ResourceType
  description  String?
  url          String?      // untuk LINK
  filePath     String?      // path file di server (diisi oleh worker)
  fileName     String?      // nama file asli
  fileSize     Int?         // bytes
  mimeType     String?
  uploadStatus UploadStatus @default(DONE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([courseId, createdAt])
  @@index([taskId])
}

enum ResourceType {
  FILE
  LINK
  NOTE
}

enum UploadStatus {
  PENDING
  DONE
  FAILED
}

model TaskSubmission {
  id             String               @id @default(uuid())
  taskId         String
  userId         String
  submissionLink String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now()) @updatedAt
  task           Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  files          TaskSubmissionFile[]

  @@unique([taskId, userId])
}

model TaskSubmissionFile {
  id           String         @id @default(uuid())
  submissionId String
  name         String
  filePath     String
  fileType     String
  fileSize     Int
  createdAt    DateTime       @default(now())
  submission   TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}
